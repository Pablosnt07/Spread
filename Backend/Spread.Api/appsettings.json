{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scoring": {
    "ModelVersion": "standard-company-v0.1.0",
    "MinimumCoverage": 0.70,
    "MinimumConfidence": 40
  },
  "FinancialData": {
    "Fmp": {
      "BaseUrl": "https://financialmodelingprep.com/stable/",
      "TimeoutSeconds": 15
    },
    "AlphaVantage": {
      "Enabled": false,
      "BaseUrl": "https://www.alphavantage.co/",
      "TimeoutSeconds": 15,
      "LookbackYears": 5,
      "OutputLimit": 20
    }
  },
  "AllowedHosts": "*"
}
